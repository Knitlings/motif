# Environment variables and secrets
.env
*.key
*.pem
credentials.json
secrets.json
config.local.*

# Personal notes and drafts
# Docs commit by default; keep personal notes out via these conventions:
#   - notes/ and drafts/ directories
#   - *.local.md and *.notes.md suffixes (ignored globally)
notes/
drafts/

# Test files (unless you want to commit them)
test-*.json
test-*.html
test-*.svg
temp.*
tmp.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies (if you add them later)
node_modules/
bower_components/

# Build outputs (if you add build process)
dist/
build/
*.min.js
*.min.css

# Test artifacts
playwright-report/
test-results/
.playwright/
coverage/
.nyc_output/
*.lcov

# Backup files
*.bak
*.backup
